# Example: "psql://user:pass@postgres:5432/db" (django-environ style)
DATABASE_URL_DOCKER="psql://postgres:postgres@postgres:5432/postgres"

# Example: "redis://redis:6379/0" (django-environ style)
CACHE_URL_DOCKER="redis://redis:6379/0"

# Example: "redis://redis:6379/1" (docker service name HOST)
CELERY_BROKER_URL_DOCKER="redis://redis:6379/1"