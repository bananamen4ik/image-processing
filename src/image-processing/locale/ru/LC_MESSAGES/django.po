#: custom_auth/models.py:77
msgid "username"
msgstr "имя пользователя"

#: custom_auth/models.py:81
msgid "Required. 150 characters or fewer. Letters, digits and @/./+/-/_ only."
msgstr ""
"Обязательное поле. Не более 150 символов. Допускаются только буквы, цифры и "
"символы @/./+/-/_."

#: custom_auth/models.py:85 custom_auth/tests.py:110
msgid "A user with that username already exists."
msgstr "Пользователь с таким именем уже существует."

#: custom_auth/models.py:89
msgid "email address"
msgstr "адрес электронной почты"

#: custom_auth/models.py:92
msgid "Required. Valid email address."
msgstr "Обязательное поле. Укажите действительный адрес электронной почты."

#: custom_auth/models.py:95 custom_auth/tests.py:130
msgid "A user with that email already exists."
msgstr "Пользователь с таким адресом электронной почты уже существует."

#: custom_auth/models.py:99
msgid "active"
msgstr "активен"

#: custom_auth/models.py:102
msgid ""
"Designates whether this user should be treated as active. Unselect this "
"instead of deleting accounts."
msgstr ""
"Определяет, следует ли считать пользователя активным. Снимите отметку вместо "
"удаления учётной записи."

#: custom_auth/models.py:107
msgid "staff status"
msgstr "статус персонала"

#: custom_auth/models.py:109
msgid "Designates whether the user can log into this admin site."
msgstr "Определяет, может ли пользователь входить в административную панель."

#: custom_auth/models.py:111
msgid "date joined"
msgstr "дата регистрации"

#: custom_auth/templates/custom_auth/email/password_reset.html:2
#, python-format
msgid ""
"You're receiving this email because you requested a password reset for your "
"user account at %(site_name)s."
msgstr ""
"Вы получили это письмо, потому что запросили сброс пароля для своей учётной "
"записи на сайте %(site_name)s."

#: custom_auth/templates/custom_auth/email/password_reset.html:4
msgid "Please go to the following page and choose a new password:"
msgstr "Перейдите по следующей ссылке и задайте новый пароль:"

#: custom_auth/templates/custom_auth/email/password_reset.html:8
msgid "In case you’ve forgotten, you are:"
msgstr "На случай, если вы забыли, ваше имя пользователя:"

#: custom_auth/templates/custom_auth/email/password_reset.html:10
msgid "Thanks for using our site!"
msgstr "Спасибо, что пользуетесь нашим сайтом!"

#: custom_auth/templates/custom_auth/email/password_reset.html:12
#, python-format
msgid "The %(site_name)s team"
msgstr "Команда %(site_name)s"

#: custom_auth/templates/custom_auth/email/password_reset_subject.txt:2
#, python-format
msgid "Password reset on %(site_name)s"
msgstr "Сброс пароля на сайте %(site_name)s"

#: custom_auth/templates/custom_auth/login.html:5
#: custom_auth/templates/custom_auth/login.html:12
#: custom_auth/templates/custom_auth/login.html:21
#: custom_auth/templates/custom_auth/password_reset_complete.html:15
#: templates/components/navbar.html:113
msgid "Log in"
msgstr "Войти"

#: custom_auth/templates/custom_auth/login.html:26
msgid "Forgot your password?"
msgstr "Забыли пароль?"

#: custom_auth/templates/custom_auth/password_reset.html:13
msgid ""
"Forgotten your password? Enter your email address below, and we’ll email "
"instructions for setting a new one."
msgstr ""
"Забыли пароль? Введите свой адрес электронной почты ниже, и мы отправим вам "
"инструкции по его восстановлению."

#: custom_auth/templates/custom_auth/password_reset.html:21
msgid "Reset my password"
msgstr "Сбросить пароль"

#: custom_auth/templates/custom_auth/password_reset_complete.html:13
msgid "Your password has been set.  You may go ahead and log in now."
msgstr "Ваш пароль успешно установлен. Теперь вы можете войти в систему."

#: custom_auth/templates/custom_auth/password_reset_confirm.html:14
msgid ""
"Please enter your new password twice so we can verify you typed it in "
"correctly."
msgstr ""
"Введите новый пароль дважды, чтобы мы могли убедиться, что вы ввели его "
"правильно."

#: custom_auth/templates/custom_auth/password_reset_confirm.html:22
#: user_profile/templates/user_profile/password_change.html:32
msgid "Change my password"
msgstr "Изменить пароль"

#: custom_auth/templates/custom_auth/password_reset_confirm.html:26
msgid ""
"The password reset link was invalid, possibly because it has already been "
"used.  Please request a new password reset."
msgstr ""
"Ссылка для сброса пароля недействительна. Возможно, она уже была "
"использована. Запросите сброс пароля ещё раз."

#: custom_auth/templates/custom_auth/password_reset_done.html:13
msgid ""
"We’ve emailed you instructions for setting your password, if an account "
"exists with the email you entered. You should receive them shortly."
msgstr ""
"Мы отправили вам инструкции по установке пароля, если учётная запись с "
"указанным адресом электронной почты существует. Вы должны получить письмо в "
"ближайшее время."

#: custom_auth/templates/custom_auth/password_reset_done.html:15
msgid ""
"If you don’t receive an email, please make sure you’ve entered the address "
"you registered with, and check your spam folder."
msgstr ""
"Если вы не получили письмо, убедитесь, что указали адрес электронной почты, "
"использованный при регистрации, и проверьте папку «Спам»."

#: custom_auth/templates/custom_auth/signup.html:5
#: custom_auth/templates/custom_auth/signup.html:21
msgid "Sign up"
msgstr "Зарегистрироваться"

#: custom_auth/templates/custom_auth/signup.html:12
#: main/templates/main/plans.html:281
msgid "Create an account"
msgstr "Создать учётную запись"

#: custom_auth/templates/custom_auth/signup.html:26
msgid "Do you have an account?"
msgstr "Уже есть учётная запись?"

#: custom_auth/tests.py:149 user_profile/tests.py:164
msgid "The two password fields didn’t match."
msgstr "Введённые пароли не совпадают."

#: custom_auth/tests.py:196
msgid ""
"Enter a valid username. This value may contain only letters, numbers, and "
"@/./+/-/_ characters."
msgstr ""
"Введите корректное имя пользователя. Оно может содержать только буквы, цифры "
"и символы @/./+/-/_."

#: custom_auth/tests.py:220 custom_auth/tests.py:497
msgid "Enter a valid email address."
msgstr "Введите корректный адрес электронной почты."

#: custom_auth/tests.py:244
#, python-format
msgid "The password is too similar to the %(verbose_name)s."
msgstr "Пароль слишком похож на значение поля «%(verbose_name)s»."

#: custom_auth/tests.py:274
#, python-format
msgid "This password is too short. It must contain at least %d character."
msgid_plural ""
"This password is too short. It must contain at least %d characters."
msgstr[0] ""
"Этот пароль слишком короткий. Он должен содержать не менее %d символа."
msgstr[1] ""
"Этот пароль слишком короткий. Он должен содержать не менее %d символов."

#: custom_auth/tests.py:299
msgid "This password is too common."
msgstr "Этот пароль слишком распространён."

#: custom_auth/tests.py:320
msgid "This password is entirely numeric."
msgstr "Этот пароль состоит только из цифр."

#: custom_auth/tests.py:374 custom_auth/tests.py:406
#, python-format
msgid ""
"Please enter a correct %(username)s and password. Note that both fields may "
"be case-sensitive."
msgstr ""
"Введите правильные %(username)s и пароль. Обратите внимание, что оба поля "
"могут учитывать регистр символов."

#: custom_auth/tests.py:647
msgid "Password reset unsuccessful"
msgstr "Не удалось сбросить пароль"

