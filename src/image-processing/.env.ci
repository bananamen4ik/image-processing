SECRET_KEY="django-insecure-test-only-key-do-not-use-in-production"
DEBUG=False

# Example: "example.com,www.example.com" (list)
ALLOWED_HOSTS=""

# Example: "psql://user:pass@127.0.0.1:5432/db" (django-environ style)
DATABASE_URL="psql://postgres:postgres@127.0.0.1:5432/postgres"

# Example: "redis://127.0.0.1:6379/0" (django-environ style)
CACHE_URL="redis://127.0.0.1:6379/0"

# Example: "redis://redis:6379/1" (docker service name HOST)
CELERY_BROKER_URL="redis://redis:6379/1"